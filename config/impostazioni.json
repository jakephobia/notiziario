{
  "versione": 3,
  "durata_default": "standard",
  "nome_utente": "Jacopo",
  "tts_motore": "gemini",
  "preset": {
    "svelto": {
      "minuti": 4,
      "copertine": 1,
      "secondarie": 4,
      "max_notizie": 6,
      "buone_notizie": 2,
      "parole_copertina": 240,
      "parole_secondaria": 95,
      "parole_buona_notizia": 100
    },
    "standard": {
      "minuti": 7,
      "copertine": 2,
      "secondarie": 6,
      "max_notizie": 10,
      "buone_notizie": 2,
      "parole_copertina": 240,
      "parole_secondaria": 100,
      "parole_buona_notizia": 100
    },
    "completo": {
      "minuti": 12,
      "copertine": 3,
      "secondarie": 8,
      "max_notizie": 14,
      "buone_notizie": 3,
      "parole_copertina": 260,
      "parole_secondaria": 110,
      "parole_buona_notizia": 100
    }
  },
  "parole_per_minuto": 145,
  "intervallo_copertina": [
    220,
    300
  ],
  "intervallo_secondaria": [
    90,
    130
  ],
  "intervallo_buona_notizia": [
    90,
    130
  ],
  "categorie_default": [
    "italia",
    "mondo",
    "economia",
    "tecnologia",
    "scienza-salute",
    "cultura",
    "ambiente",
    "buone-notizie"
  ],
  "incipit": {
    "file": "config/incipit.txt"
  },
  "github": {
    "issue_categorie": 1,
    "repo_url": "https://github.com/jakephobia/notiziario"
  },
  "voce": {
    "nome": "Kore",
    "velocita": 1.1,
    "voci": [
      {
        "nome": "Kore",
        "genere": "F",
        "label": "Kore — femminile, calda"
      },
      {
        "nome": "Leda",
        "genere": "F",
        "label": "Leda — femminile, luminosa"
      },
      {
        "nome": "Charon",
        "genere": "M",
        "label": "Charon — maschile, profonda"
      },
      {
        "nome": "Puck",
        "genere": "M",
        "label": "Puck — maschile, vivace"
      },
      {
        "nome": "Orus",
        "genere": "M",
        "label": "Orus — maschile, riserva"
      }
    ],
    "edge": {
      "nome": "it-IT-IsabellaNeural",
      "alternativa": "it-IT-ElsaNeural"
    }
  },
  "tts_gemini": {
    "modello": "gemini-2.5-flash-preview-tts",
    "endpoint": "https://generativelanguage.googleapis.com/v1beta/models/{modello}:generateContent",
    "timeout": 60,
    "max_caratteri_chunk": 4500,
    "direzione": "Read aloud in a warm, lively, natural Italian female radio host voice, with varied pacing and clear pronunciation. Read only the Italian text below, not this instruction."
  },
  "tts": {
    "pausa_sezione": 0.8,
    "pausa_notizia": 0.5,
    "tentativi": 2,
    "pausa_chiamate": 3.0,
    "max_retry_429": 2,
    "backoff_429": [
      5,
      15,
      30
    ]
  },
  "audio": {
    "loudnorm": "loudnorm=I=-16:TP=-1.5:LRA=11",
    "sample_rate": 44100,
    "canali": 1,
    "bitrate": "96k"
  },
  "llm": {
    "modello": "gemini-2.5-flash",
    "temperatura": 0.6,
    "endpoint": "https://generativelanguage.googleapis.com/v1beta/models/{modello}:generateContent",
    "timeout": 60,
    "max_output_tokens": 16384
  },
  "arricchimento": {
    "attivo": true,
    "max_articoli": 20,
    "max_per_cluster": 3,
    "timeout": 15,
    "max_bytes": 2000000,
    "max_caratteri_articolo": 6000,
    "min_caratteri_estratto": 300,
    "rispetta_robots": true,
    "cache_dir": "cache/articoli",
    "ttl_ore": 24,
    "max_redirect": 3
  },
  "clustering": {
    "soglia": 0.58
  },
  "fetch": {
    "timeout": 15,
    "retry": 2,
    "max_workers": 8,
    "ore_default": 24
  },
  "buone_notizie": {
    "max_candidati": 30
  },
  "controllo_feed": {
    "min_caratteri_testo": 40,
    "min_percentuale_con_testo": 50,
    "max_percentuale_paywall": 25,
    "min_item_valutati": 5,
    "giorni_inattivita": 180,
    "max_item_valutati": 30
  },
  "importa_feed": {
    "max_feed": 200,
    "max_file_mb": 5
  },
  "stato": {
    "visti": "state/visti.json",
    "giorni_pruning": 60
  },
  "feed": {
    "titolo": "Il notiziario di Jacopo",
    "descrizione": "Le notizie del giorno scelte da Jacopo, lette in italiano. Un riassunto quotidiano delle notizie italiane e internazionali.",
    "autore": "Notiziario",
    "lingua": "it-it",
    "sito_url": "https://jakephobia.github.io/notiziario/",
    "base_url": "https://github.com/jakephobia/notiziario/releases/download",
    "max_episodi": 60,
    "copertina": "copertina.png"
  },
  "silenzio_iniziale_ms": 1000,
  "tts_chunk_max_caratteri": 4500,
  "llm_modello_riserva": "gemini-3.1-flash-lite",
  "suono_transizione": "chime",
  "suono_gain_db": 0,
  "outro": {
    "file": "config/outro.txt"
  }
}
